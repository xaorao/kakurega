#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
need() { command -v "$1" >/dev/null || { echo "missing tool: $1"; exit 1; }; }
need git; need cargo; need node; need pnpm; need python3
node -e 'const [a,b]=process.versions.node.split(".").map(Number); if(a<22||(a===22&&b<19)){console.error("node >= 22.19 required, have "+process.version);process.exit(1)}'
rustup show active-toolchain >/dev/null 2>&1 || true
pnpm install --frozen-lockfile
cargo fetch
pnpm --filter @kakurega/web run build
cargo build -p kk-cli
# on Linux reviews run in a sandbox on this computer, with the worker beside kaku; on macOS scripts/provision-vm builds it
# inside the sandbox machine
if [ "$(uname -s)" = Linux ]; then cargo build -p kk-worker; fi
# on macOS kaku's two helpers go beside it: text recognition for pictures and scans, and the calendar reader
if [ "$(uname -s)" = Darwin ]; then sh helpers/ocr/build.sh >/dev/null; sh helpers/calendar/build.sh >/dev/null; fi
install -m 755 scripts/pre-commit .git/hooks/pre-commit
echo "setup complete"
