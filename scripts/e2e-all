#!/usr/bin/env bash
# Every end-to-end script on the Mac, in one run. scripts/test covers unit and integration tests only; this is the other half.
# Needs: the Lima VM `kak` (worker build), Playwright's Chromium, a graphical session for the Electron desktop checks.
set -euo pipefail
cd "$(dirname "$0")/.."
scripts/e2e
cargo build -p kk-cli
spikes/enclave/build.sh --test target/debug/kaku-enclave-test >/dev/null
spikes/enclave/build.sh target/debug/kaku-enclave >/dev/null
python3 tests/e2e/enclave_helper.py
python3 tests/e2e/signed_approval.py
python3 tests/e2e/signed_approval_enclave.py
python3 tests/e2e/mcp_live.py
python3 tests/e2e/telegram_fake.py
python3 tests/e2e/tui_pty.py
python3 tests/e2e/tui_linear.py
python3 tests/e2e/tui_restart.py
python3 tests/e2e/admin_restart.py
python3 tests/e2e/full_disk.py
python3 tests/e2e/tui_branch.py
python3 tests/e2e/tui_mentions.py
python3 tests/e2e/tui_mentions_lines.py
python3 tests/e2e/tui_notes_only.py
python3 tests/e2e/script_cli.py
python3 tests/e2e/telegram_proxy.py
python3 tests/e2e/chain_register.py
node tests/e2e/readiness.mjs
node tests/e2e/long_lists.mjs
node tests/e2e/extension.mjs
node tests/e2e/verifier_page.mjs
node tests/e2e/mcp_web.mjs
node tests/e2e/packs_web.mjs
node tests/e2e/roundtable_web.mjs
node tests/e2e/team_web.mjs
python3 tests/e2e/team_cli.py
python3 tests/e2e/tui_team.py
python3 tests/e2e/stop_review.py
node tests/e2e/stop_web.mjs
node tests/e2e/bundled_web.mjs
python3 tests/e2e/share_finding.py
node tests/e2e/share_web.mjs
python3 tests/e2e/notes_cli.py
python3 tests/e2e/github_cli.py
python3 tests/e2e/bench_cli.py
python3 tests/e2e/profile_cli.py
python3 scripts/bench-leak.py --out target/bench-leak-gate.json
node tests/e2e/meeting_web.mjs
node tests/e2e/explore_web.mjs
node tests/e2e/break_web.mjs
node tests/e2e/route_web.mjs
node tests/e2e/prompts_web.mjs
node tests/e2e/tabs_web.mjs
node tests/e2e/handoff_web.mjs
node tests/e2e/sample_web.mjs
node tests/e2e/projects_web.mjs
node tests/e2e/calendar_web.mjs
node tests/e2e/github_web.mjs
node tests/e2e/states_web.mjs
node tests/e2e/states2_web.mjs
node tests/e2e/verify_inapp.mjs
node tests/e2e/desktop_tray.mjs
node tests/e2e/desktop_profiles.mjs
node tests/e2e/desktop_install.mjs
node tests/e2e/hide_web.mjs
node tests/e2e/verify_receipts.mjs
node tests/e2e/diagnostics_web.mjs
node tests/e2e/model_down_web.mjs
node tests/e2e/desktop.mjs
node tests/e2e/desktop_attack.mjs
node tests/e2e/desktop_recovery.mjs
node tests/e2e/desktop_beside.mjs
node tests/e2e/desktop_forcequit.mjs
node tests/e2e/desktop_fuses.mjs
node tests/e2e/desktop_packaged.mjs
echo "ALL END-TO-END CHECKS PASSED"
