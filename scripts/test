#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# a fresh clone has no JavaScript packages yet; the lockfile decides exactly what is installed
[ -d node_modules ] || pnpm install --frozen-lockfile
python3 scripts/scan_secrets.py --selftest
python3 scripts/scan_secrets.py
python3 scripts/check_layers.py --selftest
python3 scripts/check_layers.py
python3 scripts/check_error_text.py --selftest
python3 scripts/check_error_text.py
python3 scripts/check_log_labels.py
python3 scripts/check_electron.py --selftest
cargo fmt --all -- --check
cargo clippy --workspace --all-targets -- -D warnings
cargo test --workspace
cargo build -q -p kk-cli
# the documents name the one-file check page, which is built, not kept in the repository: build it before they are checked
(cd apps/verifier-page && node build.mjs > /dev/null)
python3 scripts/docs_check.py
pnpm test
N=1000 pnpm --filter @kakurega/canon run differential
echo "ALL CHECKS PASSED"
