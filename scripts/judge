#!/usr/bin/env python3
"""Every check a judge can make with no account, no key and no funds, one line each. Needs Rust; the two NEAR lines need the network.

  scripts/judge

Builds the kaku program once, then prints PASS or FAIL per check and exits 0 only when every check passed. A line marked
SKIP could not reach NEAR's public RPC; it is not counted as a pass.
"""
import base64, json, subprocess, sys, tempfile, urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
KAKU = ROOT / "target/debug/kaku"
SAMPLE = ROOT / "fixtures/near-live/sample.kkg"
REGISTRY = "kakurega-registry-1ba6b2.testnet"
MODEL_KEY = "89154a43a47684742c3d1753252bb6f49f61da9d8c84fc9b1def2df130cb2d93"
RPC = "https://rpc.testnet.fastnear.com"
results = []


def line(state, name, detail=""):
    results.append(state)
    print(f"{state:4}  {name}" + (f"  ({detail})" if detail else ""))


def run(*args):
    return subprocess.run(args, cwd=ROOT, capture_output=True, text=True)


def view(method, args):
    body = {"jsonrpc": "2.0", "id": 1, "method": "query", "params": {"request_type": "call_function", "finality": "final", "account_id": REGISTRY, "method_name": method, "args_base64": base64.b64encode(json.dumps(args).encode()).decode()}}
    req = urllib.request.Request(RPC, data=json.dumps(body).encode(), headers={"content-type": "application/json"})
    answer = json.load(urllib.request.urlopen(req, timeout=30))
    return json.loads(bytes(answer["result"]["result"]).decode())


print("Building kaku (the first build takes several minutes) ...", flush=True)
built = run("cargo", "build", "-q", "-p", "kk-cli")
if built.returncode != 0 or not KAKU.exists():
    print(built.stderr[-2000:])
    line("FAIL", "kaku builds from this source")
    sys.exit(1)
line("PASS", "kaku builds from this source")

good = run(str(KAKU), "verify", str(SAMPLE))
line("PASS" if good.returncode == 0 and good.stdout.startswith("VALID") else "FAIL", "a real review's capsule from NEAR AI Cloud verifies offline", "fixtures/near-live/sample.kkg")

with tempfile.TemporaryDirectory() as tmp:
    altered = Path(tmp) / "altered.kkg"
    data = bytearray(SAMPLE.read_bytes())
    data[len(data) // 2] ^= 1
    altered.write_bytes(data)
    bad = run(str(KAKU), "verify", str(altered))
    line("PASS" if bad.returncode != 0 and "INVALID" in bad.stdout + bad.stderr else "FAIL", "the same capsule with one byte changed is refused", (bad.stdout + bad.stderr).strip().splitlines()[0][:60] if (bad.stdout + bad.stderr).strip() else "")

bench = run(str(KAKU), "bench", "verify", "benchmarks/leak/results.signed.json", "--pin", (ROOT / "benchmarks/leak/signer.pub").read_text().strip())
text = bench.stdout
line("PASS" if bench.returncode == 0 and "checks against the pinned key" in text and "known shapes: 126 cases" in text and "leaked 0." in text.split("known shapes: 126 cases")[1].splitlines()[0] else "FAIL", "the signed leak benchmark: 0 of 126 known secret shapes leaked", "the 10 misses beyond the detector are named in its output")

live = run("cargo", "test", "-q", "-p", "kk-evidence", "--test", "near_live")
line("PASS" if live.returncode == 0 else "FAIL", "the capsule registered on NEAR re-checks offline, every model signature included", "cargo test -p kk-evidence --test near_live")

try:
    hw = view("hardware", {"signer": MODEL_KEY})
    line("PASS" if hw and hw.get("signer") == MODEL_KEY and hw.get("tcb_status") else "FAIL", "NEAR testnet: NEAR's verifier vouched for the model key", f"tcb_status {hw.get('tcb_status')}" if hw else "no record")
except Exception as e:  # the network, not the product
    line("SKIP", "NEAR testnet: NEAR's verifier vouched for the model key", f"could not reach {RPC}: {type(e).__name__}")

try:
    rec = view("get", {"capsule_sha256": "71cb95bf7ca3ad984ff889c403bca5a83217533718aa95d747f0c4d604520aee", "capsule_signer": "f3e907329c0dafea7ee8f7fbf009ae16e410159f95466e2b7fd2a20786e36039"})
    ok = bool(rec) and rec.get("receipt_count") == 20 and str(rec.get("order")) == "0"
    line("PASS" if ok else "FAIL", "NEAR testnet: the registry holds the sample capsule with 20 verified model signatures, for paid order 0")
except Exception as e:
    line("SKIP", "NEAR testnet: the registry holds that review's capsule", f"could not reach {RPC}: {type(e).__name__}")

failed, skipped = results.count("FAIL"), results.count("SKIP")
print(f"\n{results.count('PASS')} passed, {failed} failed, {skipped} skipped.")
print("Not covered here: the live site, the browser check page, the full test suites (scripts/test, scripts/e2e-all) and whether the contract on NEAR is this build (scripts/check-deployed).")
sys.exit(1 if failed or skipped else 0)
