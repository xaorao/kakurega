#!/bin/sh
# The check for a routine commit (CLAUDE.md "EXECUTION RHYTHM"): what changed decides what runs.
#   scripts/fast-check            checks the working tree against HEAD
#   scripts/fast-check --staged   checks what is staged
# Format, then lint and tests of only the crates that changed, the web checks when the web app changed, and the guards that are
# cheap (secrets, layers, error text, documentation claims). A change in a high-risk crate stops here until its deep suites, hostile cases and mutation checks have passed (DEEP_DONE=1); the full gate runs once per batch and before every push.
set -eu
cd "$(dirname "$0")/.."
if [ "${1:-}" = "--staged" ]; then files=$(git diff --cached --name-only); else files=$(git diff --name-only HEAD; git ls-files --others --exclude-standard); fi
[ -n "$files" ] || { echo "FAST OK: nothing changed"; exit 0; }
HIGH="kk-secrets kk-policy kk-sandbox kk-broker kk-evidence kk-vault kk-disclosure kk-effects kk-kernel kk-run kk-fetch kk-update kk-companion kk-worker kk-route kk-near kk-eventlog"
crates=$(printf '%s\n' "$files" | sed -n 's#^crates/\([^/]*\)/.*#\1#p' | sort -u)
risky=""
for c in $crates; do for h in $HIGH; do [ "$c" = "$h" ] && risky="$risky $c"; done; done
if [ -n "$risky" ]; then
  echo "HIGH-RISK change in:$risky"
  echo "Batch rhythm: this commit needs these crates' deep suites, their hostile cases and mutation checks of the new safeguards now."
  echo "The full gate runs once for the batch, and always before a push."
  [ "${DEEP_DONE:-}" = "1" ] || [ "${FULL_GATE_DONE:-}" = "1" ] || { echo "FAST STOP: set DEEP_DONE=1 once the deep suites, hostile cases and mutation checks for these crates passed"; exit 3; }
fi
echo "== format"; cargo fmt --all -- --check
# every test's output is kept, so a failure that does not come back on the next run can still be named
mkdir -p target
: > target/fast-check-tests.log
for c in $crates; do
  echo "== lint and tests: $c"
  cargo clippy -q -p "$c" --all-targets -- -D warnings
  if ! cargo test -q -p "$c" >> target/fast-check-tests.log 2>&1; then
    grep -E -A12 -e '--- FAILED' -e 'panicked at' -e '^error' target/fast-check-tests.log | cut -c1-400 | head -60
    echo "FAST STOP: tests of $c failed (full output in target/fast-check-tests.log)"
    exit 1
  fi
done
if printf '%s\n' "$files" | grep -q '^apps/web/'; then
  echo "== web"; (cd apps/web && npx tsc --noEmit && node --test test/*.test.mjs)
fi
if printf '%s\n' "$files" | grep -q '^packages/'; then
  echo "== verifier (JavaScript)"; (cd packages/verifier-js && npm test >/dev/null 2>&1) || { echo "FAST CHECK FAILED: packages/verifier-js tests"; exit 1; }
fi
if printf '%s\n' "$files" | grep -qE '^(packages/|apps/verifier-page/|apps/site/)'; then
  echo "== check page and site"
  node tests/e2e/verifier_page.mjs > target/fast-check-verifier-page.log 2>&1 || { tail -5 target/fast-check-verifier-page.log; echo "FAST CHECK FAILED: tests/e2e/verifier_page.mjs"; exit 1; }
  node tests/e2e/site.mjs > target/fast-check-site.log 2>&1 || { grep -E "^FAIL" target/fast-check-site.log | head -5; echo "FAST CHECK FAILED: tests/e2e/site.mjs"; exit 1; }
fi
echo "== guards"
# each guard's last line is shown and its own exit code decides: a pipe into tail would hide a failure
guard() {
  code=0
  out=$("$@" 2>&1) || code=$?
  printf '%s\n' "$out" | tail -1 | cut -c1-160
  if [ "$code" -ne 0 ]; then printf '%s\n' "$out" | tail -12; echo "FAST CHECK FAILED: $*"; exit 1; fi
}
guard python3 scripts/scan_secrets.py
guard python3 scripts/check_recovery.py
guard python3 scripts/check_layers.py
guard python3 scripts/check_error_text.py
guard python3 scripts/check_log_labels.py
guard python3 scripts/docs_check.py
echo "FAST OK (routine commit). The full gate is still required before a push and at checkpoints."
