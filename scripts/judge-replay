#!/usr/bin/env bash
# Replays the recipient side of a Kakurega proof capsule with no account, no key and no network:
# builds the standalone check page, makes a good capsule and a forged one, and checks both with the command line.
# Needs Rust, Node and pnpm (the script installs the JavaScript packages itself on a fresh clone). Usage: scripts/judge-replay
set -euo pipefail
cd "$(dirname "$0")/.."
out=target/judge-replay
rm -rf "$out" && mkdir -p "$out"
[ -d node_modules ] || pnpm install --frozen-lockfile
cargo build -q -p kk-cli
cargo run -q -p kk-evidence --example make_receipt_capsules -- "$out"
(cd apps/verifier-page && node build.mjs)
kaku=target/debug/kaku
echo "== an EXAMPLE capsule this script just made with made-up keys and made-up model answers (it shows the check, not a real review)"
"$kaku" verify "$out/two.kkg"
echo
echo "== the same example with one model receipt altered after signing (must be refused)"
if "$kaku" verify "$out/forged.kkg"; then
  echo "FAILED: the forged capsule was accepted" >&2
  exit 1
fi
echo
echo "Both results are as expected."
echo "Open this page in any browser and drop either capsule on it: $PWD/apps/verifier-page/dist/kakurega-verify.html"
echo "Capsules: $PWD/$out/two.kkg and $PWD/$out/forged.kkg"
